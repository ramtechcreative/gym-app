# Production Environment Variables
# These will be overridden by Vercel environment variables if set

# Database Configuration - SQLite for simplicity
# In production, consider using Vercel Postgres or another managed database
DATABASE_URL="file:./prisma/prod.db"

# Application URLs - Update with your actual Vercel domain
NEXTAUTH_URL="https://gym-app-ramteck.vercel.app"
NEXT_PUBLIC_APP_URL="https://gym-app-ramteck.vercel.app"
NEXT_PUBLIC_API_URL="https://gym-app-ramteck.vercel.app"

# Authentication Secrets - These MUST be set via Vercel UI for security
# Placeholder values - MUST override in Vercel environment variables
JWT_SECRET="prod-secret-change-this-in-vercel-ui"
NEXTAUTH_SECRET="prod-nextauth-secret-change-this-in-vercel-ui"

# Node Environment
NODE_ENV="production"
