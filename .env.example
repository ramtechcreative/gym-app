# Database Configuration
# For development, use SQLite file path
# For production, use PostgreSQL URL from Vercel Postgres or Supabase
DATABASE_URL="file:./prisma/dev.db"

# Application URLs
# For development
NEXTAUTH_URL="http://localhost:3000"

# For production, replace with your Vercel domain
# NEXTAUTH_URL="https://tu-proyecto.vercel.app"

# Authentication Secrets
# Generate a strong random secret key for production
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-here-change-in-production"
NEXTAUTH_SECRET="your-nextauth-secret-here-change-in-production"

# Public API URL (exposed to browser)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Optional: Stripe Integration (for future payment processing)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."

# Optional: Email Service (for future notifications)
# SENDGRID_API_KEY="SG...."
# RESEND_API_KEY="re_..."

# Optional: Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="GA_..."
